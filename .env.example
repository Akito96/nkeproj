# Скопируйте этот файл в .env и при необходимости поменяйте значения.

# --- Приложение ---
APP_NAME="Ремонтная мастерская"
DEBUG=true
API_PREFIX=/api

# --- PostgreSQL (используются docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=repair_shop
POSTGRES_PORT=5432

# --- Подключение приложения к БД (SQLAlchemy 2.0 + psycopg 3) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/repair_shop
DB_ECHO=false

# --- CORS: адреса, с которых открывается фронтенд (JSON-список) ---
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]

# --- Загрузка файлов ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# --- JWT ---
JWT_SECRET_KEY=change-me-to-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
